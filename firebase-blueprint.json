{
  "entities": {
    "UserProfile": {
      "collection": "users",
      "fields": {
        "id": { "type": "string", "description": "Auth UID" },
        "name": { "type": "string", "description": "Display name" },
        "email": { "type": "string", "description": "Email address" },
        "role": { "type": "string", "description": "admin or participant" },
        "status": { "type": "string", "description": "active or suspended" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      }
    },
    "Material": {
      "collection": "materials",
      "fields": {
        "id": { "type": "string", "description": "Material ID" },
        "name": { "type": "string", "description": "Material name" },
        "category": { "type": "string", "description": "Category stream" },
        "pointsPerUnit": { "type": "number", "description": "Base points" },
        "co2eFactor": { "type": "number", "description": "CO2e avoided factor" },
        "active": { "type": "boolean", "description": "Availability status" }
      }
    },
    "Campaign": {
      "collection": "campaigns",
      "fields": {
        "id": { "type": "string", "description": "Campaign ID" },
        "title": { "type": "string", "description": "Campaign title" },
        "description": { "type": "string", "description": "Detailed description" },
        "type": { "type": "string", "description": "multiplier or quantity_bonus" },
        "materialId": { "type": "string", "description": "Target material ID" },
        "multiplier": { "type": "number", "description": "Multiplier factor" },
        "minimumQuantity": { "type": "number", "description": "Minimum batch threshold" },
        "bonusPoints": { "type": "number", "description": "Extra bonus points" },
        "startDate": { "type": "string", "description": "Start date" },
        "endDate": { "type": "string", "description": "End date" },
        "active": { "type": "boolean", "description": "Active state" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "createdBy": { "type": "string", "description": "Admin UID" }
      }
    },
    "Benefit": {
      "collection": "benefits",
      "fields": {
        "id": { "type": "string", "description": "Benefit ID" },
        "title": { "type": "string", "description": "Item title" },
        "description": { "type": "string", "description": "Reward description" },
        "category": { "type": "string", "description": "gift, donation, or other" },
        "pointsRequired": { "type": "number", "description": "Points required" },
        "stock": { "type": "number", "description": "Stock count or null if unlimited" },
        "active": { "type": "boolean", "description": "Catalog availability" },
        "createdAt": { "type": "string", "description": "Creation date" },
        "updatedAt": { "type": "string", "description": "Last update" }
      }
    },
    "EventItem": {
      "collection": "events",
      "fields": {
        "id": { "type": "string", "description": "Event ID" },
        "title": { "type": "string", "description": "Event name" },
        "description": { "type": "string", "description": "Event instructions" },
        "date": { "type": "string", "description": "Event date" },
        "time": { "type": "string", "description": "Event time" },
        "location": { "type": "string", "description": "Location description" },
        "category": { "type": "string", "description": "Category badge" },
        "active": { "type": "boolean", "description": "Published state" },
        "createdAt": { "type": "string", "description": "Creation date" }
      }
    },
    "CollectionPoint": {
      "collection": "collectionPoints",
      "fields": {
        "id": { "type": "string", "description": "Ecoponto ID" },
        "name": { "type": "string", "description": "Station name" },
        "address": { "type": "string", "description": "Physical address" },
        "neighborhood": { "type": "string", "description": "Neighborhood" },
        "latitude": { "type": "number", "description": "GPS Latitude" },
        "longitude": { "type": "number", "description": "GPS Longitude" },
        "openingHours": { "type": "string", "description": "Opening hours" },
        "acceptedMaterials": { "type": "array", "description": "List of material names" },
        "active": { "type": "boolean", "description": "Operational state" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      }
    },
    "RecyclingRecord": {
      "collection": "recyclingRecords",
      "fields": {
        "id": { "type": "string", "description": "Immutable transaction ID" },
        "userId": { "type": "string", "description": "Participant UID" },
        "materialId": { "type": "string", "description": "Material ID" },
        "quantity": { "type": "number", "description": "Items count" },
        "basePoints": { "type": "number", "description": "Normal points" },
        "campaignBonus": { "type": "number", "description": "Campaign extra points" },
        "pointsEarned": { "type": "number", "description": "Total points awarded" },
        "campaignId": { "type": "string", "description": "Active campaign applied" },
        "createdAt": { "type": "string", "description": "Transaction timestamp" },
        "registeredByAdminUid": { "type": "string", "description": "Admin UID" }
      }
    }
  }
}
